    "sv": "Jag köpte en bok.",
    "note": "Kvinna: *kupila*. Man: *kupio*.",
    "source": "tatoeba:6938092"
  },
  {
    "id": "l43-s4",
    "lesson": 43,
    "sr": "Plaćam unaprijed.",
    "sv": "Jag betalar i förskott.",
    "note": "Ekaviskt: *unapred*.",
    "source": "tatoeba:893558"
  },
  {
    "id": "l43-s5",
    "lesson": 43,
    "sr": "Šta tražiš?",
    "sv": "Vad letar du efter?",
    "source": "tatoeba:3384098"
  },
  {
    "id": "l44-s1",
    "lesson": 44,
    "sr": "On spava.",
    "sv": "Han sover.",
    "source": "tatoeba:10822104"
  },
  {
    "id": "l44-s2",
    "lesson": 44,
    "sr": "Da li živiš ovdje?",
    "sv": "Bor du här?",
    "source": "tatoeba:3318107"
  },
  {
    "id": "l44-s3",
    "lesson": 44,
    "sr": "Dođi i sjedi.",
    "sv": "Kom och sätt dig.",
    "note": "Ekaviskt: *sedi*.",
    "source": "tatoeba:4449668"
  },
  {
    "id": "l44-s4",
    "lesson": 44,
    "sr": "Stojim ovdje.",
    "sv": "Jag står här."
  },
  {
    "id": "l44-s5",
    "lesson": 44,
    "sr": "Moja sestra se igra sa lutkama.",
    "sv": "Min syster leker med dockor.",
    "note": "*lutka* = docka",
    "source": "tatoeba:800881"
  },
  {
    "id": "l45-s1",
    "lesson": 45,
    "sr": "Pomozi mi!",
    "sv": "Hjälp mig!",
    "source": "tatoeba:3478054"
  },
  {
    "id": "l45-s2",
    "lesson": 45,
    "sr": "Treba mi taksi.",
    "sv": "Jag behöver en taxi.",
    "source": "tatoeba:3368553"
  },
  {
    "id": "l45-s3",
    "lesson": 45,
    "sr": "Stvarno mi se sviđa tvoja muzika.",
    "sv": "Jag gillar verkligen din musik.",
    "source": "tatoeba:5034803"
  },
  {
    "id": "l45-s4",
    "lesson": 45,
    "sr": "Mogu li da pitam zašto?",
    "sv": "Får jag fråga varför?",
    "source": "tatoeba:4449723"
  },
  {
    "id": "l45-s5",
    "lesson": 45,
    "sr": "Nadam se da nisi ljut na mene.",
    "sv": "Jag hoppas att du inte är arg på mig.",
    "note": "*nisi* = du är inte",
    "source": "tatoeba:3531402"
  },
  {
    "id": "l46-s1",
    "lesson": 46,
    "sr": "Tužna si.",
    "sv": "Du är ledsen.",
    "source": "tatoeba:6924673"
  },
  {
    "id": "l46-s2",
    "lesson": 46,
    "sr": "Bolesna sam.",
    "sv": "Jag är sjuk."
  },
  {
    "id": "l46-s3",
    "lesson": 46,
    "sr": "Zdrava sam.",
    "sv": "Jag är frisk."
  },
  {
    "id": "l46-s4",
    "lesson": 46,
    "sr": "Spremna sam!",
    "sv": "Jag är redo!",
    "source": "tatoeba:4992615"
  },
  {
    "id": "l46-s5",
    "lesson": 46,
    "sr": "Danas sam zauzeta.",
    "sv": "Jag är upptagen idag."
  },
  {
    "id": "l47-s1",
    "lesson": 47,
    "sr": "Boli te glava?",
    "sv": "Har du ont i huvudet?",
    "source": "tatoeba:7014784"
  },
  {
    "id": "l47-s2",
    "lesson": 47,
    "sr": "Ruke su mi pune.",
    "sv": "Jag har händerna fulla.",
    "note": "*pune* = fulla",
    "source": "tatoeba:4784487"
  },
  {
    "id": "l47-s3",
    "lesson": 47,
    "sr": "Boli me noga.",
    "sv": "Det gör ont i foten.",
    "alt": ["Noga me boli."]
  },
  {
    "id": "l47-s4",
    "lesson": 47,
    "sr": "Imam plave oči.",
    "sv": "Jag har blå ögon.",
    "source": "tatoeba:3435556"
  },
  {
    "id": "l47-s5",
    "lesson": 47,
    "sr": "Ona ima dobro srce.",
    "sv": "Hon har ett gott hjärta.",
    "source": "tatoeba:6791476"
  },
  {
    "id": "l48-s1",
    "lesson": 48,
    "sr": "Boli me glava.",
    "sv": "Jag har ont i huvudet.",
    "source": "tatoeba:3243462"
  },
  {
    "id": "l48-s2",
    "lesson": 48,
    "sr": "On nije doktor.",
    "sv": "Han är inte läkare.",
    "source": "tatoeba:665383"
  },
  {
    "id": "l48-s3",
    "lesson": 48,
    "sr": "Treba mi lijek.",
    "sv": "Jag behöver medicin.",
    "note": "Ekaviskt: *lek*."
  },
  {
    "id": "l48-s4",
    "lesson": 48,
    "sr": "Ona želi raditi u bolnici.",
    "sv": "Hon vill arbeta på ett sjukhus.",
    "source": "tatoeba:2332778"
  },
  {
    "id": "l48-s5",
    "lesson": 48,
    "sr": "Treba nam tvoja pomoć.",
    "sv": "Vi behöver din hjälp.",
    "source": "tatoeba:4261732"
  },
  {
    "id": "l49-s1",
    "lesson": 49,
    "sr": "Imam mačku i psa.",
    "sv": "Jag har en katt och en hund.",
    "note": "*pas* → *psa* (ackusativ).",
    "source": "tatoeba:3307023"
  },
  {
    "id": "l49-s2",
    "lesson": 49,
    "sr": "Kafa ili čaj?",
    "sv": "Kaffe eller te?",
    "source": "tatoeba:3437801"
  },
  {
    "id": "l49-s3",
    "lesson": 49,
    "sr": "Dođi, ako možeš.",
    "sv": "Kom om du kan."
  },
  {
    "id": "l49-s4",
    "lesson": 49,
    "sr": "Jedi dok je toplo.",
    "sv": "Ät medan det är varmt."
  },
  {
    "id": "l49-s5",
    "lesson": 49,
    "sr": "Bolje nego juče.",
    "sv": "Bättre än igår.",
    "note": "*bolje* = bättre"
  },
  {
    "id": "l50-s1",
    "lesson": 50,
    "sr": "Samo zatvori oči.",
    "sv": "Blunda bara.",
    "note": "Ordagrant: stäng bara ögonen.",
    "source": "tatoeba:6955845"
  },
  {
    "id": "l50-s2",
    "lesson": 50,
    "sr": "Pokušaj opet.",
    "sv": "Försök igen.",
    "note": "*pokušaj* = försök!",
    "source": "tatoeba:3278264"
  },
  {
    "id": "l50-s3",
    "lesson": 50,
    "sr": "Da li ste već doručkovali?",
    "sv": "Har ni redan ätit frukost?",
    "source": "tatoeba:11183918"
  },
  {
    "id": "l50-s4",
    "lesson": 50,
    "sr": "To je bilo vrlo jeftino.",
    "sv": "Det var väldigt billigt.",
    "note": "*jeftino* = billigt",
    "source": "tatoeba:3425925"
  },
  {
    "id": "l50-s5",
    "lesson": 50,
    "sr": "Zašto baš ja?",
    "sv": "Varför just jag?",
    "source": "tatoeba:6314414"
  },
  {
    "id": "l51-s1",
    "lesson": 51,
    "sr": "Kako to?",
    "sv": "Hur så?",
    "source": "tatoeba:6880656"
  },
  {
    "id": "l51-s2",
    "lesson": 51,
    "sr": "Kakav ti je bio dan?",
    "sv": "Hur var din dag?",
    "source": "tatoeba:6447029"
  },
  {
    "id": "l51-s3",
    "lesson": 51,
    "sr": "Koji je tvoj problem?",
    "sv": "Vad är ditt problem?",
    "source": "tatoeba:4504897"
  },
  {
    "id": "l51-s4",
    "lesson": 51,
    "sr": "Čije je ovo?",
    "sv": "Vems är det här?",
    "source": "tatoeba:3281750"
  },
  {
    "id": "l51-s5",
    "lesson": 51,
    "sr": "Odakle si?",
    "sv": "Var kommer du ifrån?",
    "source": "tatoeba:3334516"
  },
  {
    "id": "l52-s1",
    "lesson": 52,
    "sr": "Idem sa tobom.",
    "sv": "Jag följer med dig.",
    "note": "Man kan också säga: *Idem s tobom*."
  },
  {
    "id": "l52-s2",
    "lesson": 52,
    "sr": "Mogu da živim bez vode.",
    "sv": "Jag kan leva utan vatten.",
    "note": "*voda* → *bez vode* (genitiv).",
    "source": "tatoeba:2655864"
  },
  {
    "id": "l52-s3",
    "lesson": 52,
    "sr": "Ovo je za tebe.",
    "sv": "Det här är till dig."
  },
  {
    "id": "l52-s4",
    "lesson": 52,
    "sr": "Ovo je od mame.",
    "sv": "Det här är från mamma.",
    "note": "*mama* → *od mame* (genitiv)."
  },
  {
    "id": "l52-s5",
    "lesson": 52,
    "sr": "Vidimo se sutra!",
    "sv": "Vi ses imorgon!"
  },
  {
    "id": "l53-s1",
    "lesson": 53,
    "sr": "Idem na plažu.",
    "sv": "Jag går till stranden.",
    "note": "*plaža* → *na plažu* (ackusativ).",
    "source": "tatoeba:4250142"
  },
  {
    "id": "l53-s2",
    "lesson": 53,
    "sr": "Ja sam iz Švedske.",
    "sv": "Jag är från Sverige.",
    "note": "*Švedska* → *iz Švedske* (genitiv)."
  },
  {
    "id": "l53-s3",
    "lesson": 53,
    "sr": "Hoćeš li da ostaneš kod kuće?",
    "sv": "Vill du stanna hemma?",
    "source": "tatoeba:3425566"
  },
  {
    "id": "l53-s4",
    "lesson": 53,
    "sr": "Maj dolazi poslije aprila.",
    "sv": "Maj kommer efter april.",
    "note": "Ekaviskt: *posle*.",
    "source": "tatoeba:901909"
  },
  {
    "id": "l53-s5",
    "lesson": 53,
    "sr": "Vidjela sam ga prije tri godine.",
    "sv": "Jag såg honom för tre år sedan.",
    "note": "Kvinna: *vidjela*. Man: *vidio*.",
    "source": "tatoeba:3334430"
  },
  {
    "id": "l54-s1",
    "lesson": 54,
    "sr": "Izvinite, gdje je toalet?",
    "sv": "Ursäkta, var är toaletten?"
  },
  {
    "id": "l54-s2",
    "lesson": 54,
    "sr": "Naravno da ću ti pomoći.",
    "sv": "Självklart hjälper jag dig.",
    "source": "tatoeba:3340832"
  },
  {
    "id": "l54-s3",
    "lesson": 54,
    "sr": "To je stvarno iznenađujuće.",
    "sv": "Det är verkligen överraskande.",
    "source": "tatoeba:4992728"
  },
  {
    "id": "l54-s4",
    "lesson": 54,
    "sr": "Nema problema!",
    "sv": "Inga problem!",
    "source": "tatoeba:11183485"
  },
  {
    "id": "l54-s5",
    "lesson": 54,
    "sr": "Sve je u redu.",
    "sv": "Allt är bra.",
    "source": "tatoeba:3644357"
  },
  {
    "id": "l55-s1",
    "lesson": 55,
    "sr": "Hajde da probamo nešto.",
    "sv": "Kom, så provar vi något.",
    "note": "*nešto* = något",
    "source": "tatoeba:3292799"
  },
  {
    "id": "l55-s2",
    "lesson": 55,
    "sr": "Hodaj polako.",
    "sv": "Gå långsamt.",
    "source": "tatoeba:5003555"
  },
  {
    "id": "l55-s3",
    "lesson": 55,
    "sr": "Meni je svejedno.",
    "sv": "Det spelar ingen roll för mig."
  },
  {
    "id": "l55-s4",
    "lesson": 55,
    "sr": "Dobrodošli u našu kuću!",
    "sv": "Välkomna till vårt hus!"
  },
  {
    "id": "l55-s5",
    "lesson": 55,
    "sr": "Vidimo se!",
    "sv": "Vi ses!",
    "source": "tatoeba:3265451"
  },
  {
    "id": "l56-s1",
    "lesson": 56,
    "sr": "Moje ime je Ana.",
    "sv": "Jag heter Ana.",
    "note": "Byt Ana mot ditt eget namn när du övar högt.",
    "source": "tatoeba:7531110"
  },
  {
    "id": "l56-s2",
    "lesson": 56,
    "sr": "Koliko jezika govoriš?",
    "sv": "Hur många språk talar du?",
    "source": "tatoeba:3419230"
  },
  {
    "id": "l56-s3",
    "lesson": 56,
    "sr": "Ovo je lijepa zemlja.",
    "sv": "Det här är ett vackert land."
  },
  {
    "id": "l56-s4",
    "lesson": 56,
    "sr": "Novac je na stolu.",
    "sv": "Pengarna ligger på bordet.",
    "source": "tatoeba:3246440"
  },
  {
    "id": "l56-s5",
    "lesson": 56,
    "sr": "Gdje je moj telefon?",
    "sv": "Var är min telefon?"
  },
  {
    "id": "l57-s1",
    "lesson": 57,
    "sr": "Pjevao je pjesmu.",
    "sv": "Han sjöng en sång.",
    "note": "Ekaviskt: *pevao, pesmu*.",
    "source": "tatoeba:2507715"
  },
  {
    "id": "l57-s2",
    "lesson": 57,
    "sr": "On mnogo voli muziku.",
    "sv": "Han älskar musik.",
    "source": "tatoeba:3245270"
  },
  {
    "id": "l57-s3",
    "lesson": 57,
    "sr": "Ovo je poklon za tebe.",
    "sv": "Det här är en present till dig."
  },
  {
    "id": "l57-s4",
    "lesson": 57,
    "sr": "Gosti dolaze večeras.",
    "sv": "Gästerna kommer ikväll."
  },
  {
    "id": "l57-s5",
    "lesson": 57,
    "sr": "Svadba je u subotu.",
    "sv": "Bröllopet är på lördag."
  },
  {
    "id": "l58-s1",
    "lesson": 58,
    "sr": "Sretan Božić!",
    "sv": "God jul!",
    "note": "I Serbien: *srećan*.",
    "source": "tatoeba:10198913"
  },
  {
    "id": "l58-s2",
    "lesson": 58,
    "sr": "Sretan Vaskrs!",
    "sv": "Glad påsk!",
    "note": "Även *Uskrs*.",
    "source": "tatoeba:3188083"
  },
  {
    "id": "l58-s3",
    "lesson": 58,
    "sr": "Crkva je blizu.",
    "sv": "Kyrkan ligger nära."
  },
  {
    "id": "l58-s4",
    "lesson": 58,
    "sr": "Upali svijeću.",
    "sv": "Tänd ett ljus.",
    "note": "*upali* = tänd!"
  },
  {
    "id": "l58-s5",
    "lesson": 58,
    "sr": "To je naš običaj.",
    "sv": "Det är vår sed."
  },
  {
    "id": "l59-s1",
    "lesson": 59,
    "sr": "Voda je život.",
    "sv": "Vatten är liv.",
    "source": "tatoeba:5978196"
  },
  {
    "id": "l59-s2",
    "lesson": 59,
    "sr": "Da li je to ljubav?",
    "sv": "Är det kärlek?",
    "source": "tatoeba:665384"
  },
  {
    "id": "l59-s3",
    "lesson": 59,
    "sr": "Ona je prijateljica moje sestre.",
    "sv": "Hon är min systers väninna.",
    "source": "tatoeba:6197183"
  },
  {
    "id": "l59-s4",
    "lesson": 59,
    "sr": "Ko je tvoj komšija?",
    "sv": "Vem är din granne?"
  },
  {
    "id": "l59-s5",
    "lesson": 59,
    "sr": "To je duga priča.",
    "sv": "Det är en lång historia.",
    "source": "tatoeba:3357029"
  },
  {
    "id": "l60-s1",
    "lesson": 60,
    "sr": "Dobro jutro!",
    "sv": "God morgon!",
    "source": "tatoeba:3384118"
  },
  {
    "id": "l60-s2",
    "lesson": 60,
    "sr": "Dobro veče!",
    "sv": "God kväll!",
    "source": "tatoeba:5003682"
  },
  {
    "id": "l60-s3",
    "lesson": 60,
    "sr": "Laku noć!",
    "sv": "God natt!",
    "source": "tatoeba:7788382"
  },
  {
    "id": "l60-s4",
    "lesson": 60,
    "sr": "Doviđenja, vidimo se sutra!",
    "sv": "Hej då, vi ses imorgon!"
  },
  {
    "id": "l60-s5",
    "lesson": 60,
    "sr": "Čujemo se sutra!",
    "sv": "Vi hörs imorgon!"
  }
]
