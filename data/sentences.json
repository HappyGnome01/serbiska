[
  {
    "id": "l1-s1",
    "lesson": 1,
    "sr": "Zdravo, kako si?",
    "sv": "Hej, hur mår du?"
  },
  {
    "id": "l1-s2",
    "lesson": 1,
    "sr": "Dobro sam, hvala.",
    "sv": "Jag mår bra, tack.",
    "note": "sam = jag är"
  },
  {
    "id": "l1-s3",
    "lesson": 1,
    "sr": "Dobar dan, kako ste?",
    "sv": "God dag, hur mår ni?",
    "note": "ste är den artiga formen. Använd den till äldre."
  },
  {
    "id": "l1-s4",
    "lesson": 1,
    "sr": "Hvala, dobro.",
    "sv": "Tack, bra."
  },
  {
    "id": "l1-s5",
    "lesson": 1,
    "sr": "Dobro, a ti?",
    "sv": "Bra, och du?",
    "note": "a = och (när man vänder på frågan)"
  },
  {
    "id": "l2-s1",
    "lesson": 2,
    "sr": "Može kafa?",
    "sv": "Vill du ha kaffe?",
    "note": "Ordagrant: går det med kaffe?"
  },
  {
    "id": "l2-s2",
    "lesson": 2,
    "sr": "Da, molim.",
    "sv": "Ja tack."
  },
  {
    "id": "l2-s3",
    "lesson": 2,
    "sr": "Ne, hvala.",
    "sv": "Nej tack."
  },
  {
    "id": "l2-s4",
    "lesson": 2,
    "sr": "Da, može.",
    "sv": "Ja, gärna."
  },
  {
    "id": "l2-s5",
    "lesson": 2,
    "sr": "Izvini, molim?",
    "sv": "Förlåt, vad sa du?"
  },
  {
    "id": "l3-s1",
    "lesson": 3,
    "sr": "Zovem se Ana.",
    "sv": "Jag heter Ana.",
    "note": "Byt Ana mot ditt eget namn när du övar högt."
  },
  {
    "id": "l3-s2",
    "lesson": 3,
    "sr": "Kako se zoveš?",
    "sv": "Vad heter du?"
  },
  {
    "id": "l3-s3",
    "lesson": 3,
    "sr": "Drago mi je!",
    "sv": "Trevligt att träffas!"
  },
  {
    "id": "l3-s4",
    "lesson": 3,
    "sr": "Ne razumijem.",
    "sv": "Jag förstår inte."
  },
  {
    "id": "l3-s5",
    "lesson": 3,
    "sr": "Ja ne govorim dobro srpski.",
    "sv": "Jag pratar inte så bra serbiska.",
    "note": "govorim = jag pratar"
  },
  {
    "id": "l4-s1",
    "lesson": 4,
    "sr": "Ovo je mama.",
    "sv": "Det här är mamma.",
    "note": "ovo je = det här är"
  },
  {
    "id": "l4-s2",
    "lesson": 4,
    "sr": "Tata je ovdje.",
    "sv": "Pappa är här."
  },
  {
    "id": "l4-s3",
    "lesson": 4,
    "sr": "Imaš li brata?",
    "sv": "Har du en bror?",
    "note": "brat → brata efter 'har du' (ackusativ)."
  },
  {
    "id": "l4-s4",
    "lesson": 4,
    "sr": "Moja sestra je u Švedskoj.",
    "sv": "Min syster är i Sverige.",
    "note": "Švedska → u Švedskoj (lokativ: var något är)."
  },
  {
    "id": "l4-s5",
    "lesson": 4,
    "sr": "Velika porodica!",
    "sv": "En stor familj!"
  },
  {
    "id": "l5-s1",
    "lesson": 5,
    "sr": "Ovo je baka.",
    "sv": "Det här är farmor."
  },
  {
    "id": "l5-s2",
    "lesson": 5,
    "sr": "Djed je u bašti.",
    "sv": "Farfar är i trädgården.",
    "note": "bašta → u bašti (lokativ)."
  },
  {
    "id": "l5-s3",
    "lesson": 5,
    "sr": "Ja sam njegova djevojka.",
    "sv": "Jag är hans flickvän.",
    "note": "njegova = hans"
  },
  {
    "id": "l5-s4",
    "lesson": 5,
    "sr": "On je moj momak.",
    "sv": "Han är min pojkvän."
  },
  {
    "id": "l5-s5",
    "lesson": 5,
    "sr": "Ovo je moj prijatelj.",
    "sv": "Det här är min vän."
  },
  {
    "id": "l6-s1",
    "lesson": 6,
    "sr": "Hoćeš li kafu?",
    "sv": "Vill du ha kaffe?",
    "note": "kafa → kafu efter 'vill du ha' (ackusativ)."
  },
  {
    "id": "l6-s2",
    "lesson": 6,
    "sr": "Čašu vode, molim.",
    "sv": "Ett glas vatten, tack.",
    "note": "voda → vode: 'ett glas av vatten' (genitiv)."
  },
  {
    "id": "l6-s3",
    "lesson": 6,
    "sr": "Kafa sa mlijekom.",
    "sv": "Kaffe med mjölk.",
    "note": "mlijeko → mlijekom efter sa = med (instrumental)."
  },
  {
    "id": "l6-s4",
    "lesson": 6,
    "sr": "Ovo je domaći hljeb.",
    "sv": "Det här är hembakat bröd.",
    "note": "domaći = hemgjord"
  },
  {
    "id": "l6-s5",
    "lesson": 6,
    "sr": "Ne pijem kafu, može čaj?",
    "sv": "Jag dricker inte kaffe, går det bra med te?"
  },
  {
    "id": "l7-s1",
    "lesson": 7,
    "sr": "Prijatno!",
    "sv": "Smaklig måltid!"
  },
  {
    "id": "l7-s2",
    "lesson": 7,
    "sr": "Ovo je jako ukusno!",
    "sv": "Det här är jättegott!",
    "note": "jako = väldigt"
  },
  {
    "id": "l7-s3",
    "lesson": 7,
    "sr": "Hoćeš li još?",
    "sv": "Vill du ha mer?"
  },
  {
    "id": "l7-s4",
    "lesson": 7,
    "sr": "Hvala, sita sam.",
    "sv": "Tack, jag är mätt."
  },
  {
    "id": "l7-s5",
    "lesson": 7,
    "sr": "Jedi, jedi!",
    "sv": "Ät, ät!",
    "note": "Klassiskt från värdar och mor- och farföräldrar."
  },
  {
    "id": "l8-s1",
    "lesson": 8,
    "sr": "Živjeli!",
    "sv": "Skål!"
  },
  {
    "id": "l8-s2",
    "lesson": 8,
    "sr": "Hoćeš li rakiju?",
    "sv": "Vill du ha rakija?",
    "note": "rakija → rakiju (ackusativ)."
  },
  {
    "id": "l8-s3",
    "lesson": 8,
    "sr": "Sretna slava!",
    "sv": "Glad slava!",
    "note": "Lyckönskan när du kommer till en slava."
  },
  {
    "id": "l8-s4",
    "lesson": 8,
    "sr": "Čestitam rođendan!",
    "sv": "Grattis på födelsedagen!"
  },
  {
    "id": "l8-s5",
    "lesson": 8,
    "sr": "Sretno na putu!",
    "sv": "Trevlig resa!",
    "note": "Ordagrant: lycka till på vägen."
  },
  {
    "id": "l9-s1",
    "lesson": 9,
    "sr": "Šta je ovo?",
    "sv": "Vad är det här?"
  },
  {
    "id": "l9-s2",
    "lesson": 9,
    "sr": "Ko je to?",
    "sv": "Vem är det?"
  },
  {
    "id": "l9-s3",
    "lesson": 9,
    "sr": "Gdje je toalet?",
    "sv": "Var är toaletten?"
  },
  {
    "id": "l9-s4",
    "lesson": 9,
    "sr": "Kada dolaziš?",
    "sv": "När kommer du?"
  },
  {
    "id": "l9-s5",
    "lesson": 9,
    "sr": "Koliko imaš godina?",
    "sv": "Hur gammal är du?",
    "note": "Ordagrant: hur många år har du?"
  },
  {
    "id": "l10-s1",
    "lesson": 10,
    "sr": "Lijepo je ovdje.",
    "sv": "Det är fint här."
  },
  {
    "id": "l10-s2",
    "lesson": 10,
    "sr": "Volim te.",
    "sv": "Jag älskar dig."
  },
  {
    "id": "l10-s3",
    "lesson": 10,
    "sr": "Volim srpsku hranu.",
    "sv": "Jag älskar serbisk mat.",
    "note": "hrana = mat → hranu (ackusativ)."
  },
  {
    "id": "l10-s4",
    "lesson": 10,
    "sr": "Malo sam umorna.",
    "sv": "Jag är lite trött.",
    "note": "malo = lite"
  },
  {
    "id": "l10-s5",
    "lesson": 10,
    "sr": "Sretna sam što sam ovdje.",
    "sv": "Jag är glad att jag är här."
  },
  {
    "id": "l11-s1",
    "lesson": 11,
    "sr": "Ne znam šta je to.",
    "sv": "Jag vet inte vad det är.",
    "source": "tatoeba:3253759"
  },
  {
    "id": "l11-s2",
    "lesson": 11,
    "sr": "Mogu li dobiti čašu vina?",
    "sv": "Kan jag få ett glas vin?",
    "note": "čaša → čašu (ackusativ). vino → vina: 'ett glas av vin' (genitiv).",
    "source": "tatoeba:4992851"
  },
  {
    "id": "l11-s3",
    "lesson": 11,
    "sr": "Imam pitanje.",
    "sv": "Jag har en fråga.",
    "note": "pitanje = fråga",
    "source": "tatoeba:11183020"
  },
  {
    "id": "l11-s4",
    "lesson": 11,
    "sr": "Moraš da mi vjeruješ.",
    "sv": "Du måste lita på mig.",
    "note": "vjerovati = lita på. Ekaviskt: veruješ.",
    "source": "tatoeba:6963584"
  },
  {
    "id": "l11-s5",
    "lesson": 11,
    "sr": "Mogu li da idem?",
    "sv": "Kan jag gå?",
    "note": "li gör meningen till en fråga.",
    "source": "tatoeba:4992862"
  },
  {
    "id": "l12-s1",
    "lesson": 12,
    "sr": "Danas je hladno.",
    "sv": "Det är kallt idag.",
    "note": "hladno = kallt",
    "source": "tatoeba:4726292"
  },
  {
    "id": "l12-s2",
    "lesson": 12,
    "sr": "Dođi sutra.",
    "sv": "Kom imorgon.",
    "note": "dođi = kom! (från doći)",
    "source": "tatoeba:4995968"
  },
  {
    "id": "l12-s3",
    "lesson": 12,
    "sr": "Gdje si sada?",
    "sv": "Var är du nu?",
    "note": "Ekaviskt: Gde si sada?",
    "source": "tatoeba:5039825"
  },
  {
    "id": "l12-s4",
    "lesson": 12,
    "sr": "Moja majka je uvijek zauzeta.",
    "sv": "Min mamma är alltid upptagen.",
    "note": "zauzeta = upptagen (om en kvinna). Om en man: zauzet.",
    "source": "tatoeba:3253705"
  },
  {
    "id": "l12-s5",
    "lesson": 12,
    "sr": "Sad ili nikad!",
    "sv": "Nu eller aldrig!",
    "note": "ili = eller",
    "source": "tatoeba:6937649"
  },
  {
    "id": "l13-s1",
    "lesson": 13,
    "sr": "Idem kući.",
    "sv": "Jag går hem.",
    "source": "tatoeba:1478648"
  },
  {
    "id": "l13-s2",
    "lesson": 13,
    "sr": "Tražim posao.",
    "sv": "Jag söker jobb.",
    "note": "tražim = jag söker",
    "source": "tatoeba:892219"
  },
  {
    "id": "l13-s3",
    "lesson": 13,
    "sr": "Gdje je žena?",
    "sv": "Var är kvinnan?",
    "source": "tatoeba:2342031"
  },
  {
    "id": "l13-s4",
    "lesson": 13,
    "sr": "Čak i dijete zna to.",
    "sv": "Det vet till och med ett barn.",
    "note": "čak i = till och med. Ekaviskt: dete.",
    "source": "tatoeba:4992730"
  },
  {
    "id": "l13-s5",
    "lesson": 13,
    "sr": "Ko su ovi ljudi?",
    "sv": "Vilka är de här människorna?",
    "note": "ovi = de här",
    "source": "tatoeba:3429825"
  },
  {
    "id": "l14-s1",
    "lesson": 14,
    "sr": "Zašto si ljuta na mene?",
    "sv": "Varför är du arg på mig?",
    "note": "ljuta = arg (om en kvinna). Om en man: ljut.",
    "source": "tatoeba:5034640"
  },
  {
    "id": "l14-s2",
    "lesson": 14,
    "sr": "Ne mogu, jer idem kući.",
    "sv": "Jag kan inte eftersom jag ska hem."
  },
  {
    "id": "l14-s3",
    "lesson": 14,
    "sr": "Bili smo siromašni, ali sretni.",
    "sv": "Vi var fattiga men glada.",
    "note": "siromašni = fattiga. I Serbien: srećni.",
    "source": "tatoeba:3437802"
  },
  {
    "id": "l14-s4",
    "lesson": 14,
    "sr": "Možda si u pravu.",
    "sv": "Du kanske har rätt.",
    "note": "biti u pravu = ha rätt",
    "source": "tatoeba:3426483"
  },
  {
    "id": "l14-s5",
    "lesson": 14,
    "sr": "Mnogo volim mačke.",
    "sv": "Jag gillar katter väldigt mycket.",
    "note": "mačka → mačke (ackusativ, flertal).",
    "source": "tatoeba:9117164"
  },
  {
    "id": "l15-s1",
    "lesson": 15,
    "sr": "Želim da budem sa tobom.",
    "sv": "Jag vill vara med dig.",
    "note": "sa tobom = med dig",
    "source": "tatoeba:6920341"
  },
  {
    "id": "l15-s2",
    "lesson": 15,
    "sr": "Mislim da si u pravu.",
    "sv": "Jag tror att du har rätt.",
    "source": "tatoeba:3426484"
  },
  {
    "id": "l15-s3",
    "lesson": 15,
    "sr": "Dođi da nas vidiš.",
    "sv": "Kom och hälsa på oss.",
    "note": "Ordagrant: kom så att du ser oss.",
    "source": "tatoeba:4449669"
  },
  {
    "id": "l15-s4",
    "lesson": 15,
    "sr": "Šta radiš?",
    "sv": "Vad gör du?",
    "source": "tatoeba:11183534"
  },
  {
    "id": "l15-s5",
    "lesson": 15,
    "sr": "Šta da kažem?",
    "sv": "Vad ska jag säga?"
  }
]